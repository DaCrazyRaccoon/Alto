{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alto:script:1",
  "title": "Alto script, version 1",
  "description": "Structure of an Alto script file (*.alto.json). The schema checks shape, field names, literal ranges and id formats; Alto's validator additionally checks names and references, static types, recursion, break placement and the loop guard. Reference: docs/alto/SCRIPT_LANGUAGE.md.",
  "$comment": "Kept in sync with baritone.alto.script.lang (ActionType, Fields, Limits) by SchemaTest.",
  "type": "object",
  "properties": {
    "format": {
      "const": "alto-script"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "procedures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/procedure"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/handler"
      }
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "events"
  ],
  "additionalProperties": false,
  "$defs": {
    "name": {
      "description": "Name of a variable, procedure or parameter: a letter or _, then letters, digits or _.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 64
    },
    "id": {
      "description": "Item or block id, lower case. The namespace is optional and defaults to minecraft.",
      "type": "string",
      "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$",
      "maxLength": 200,
      "examples": [
        "minecraft:oak_planks",
        "oak_planks",
        "create:shaft"
      ]
    },
    "fileName": {
      "description": "Plain file name inside Alto's schematics folder: no folders, no '..', not starting with a dot or space.",
      "type": "string",
      "pattern": "^(?![ .])(?!.*\\.\\.)[A-Za-z0-9 _.()+-]*[A-Za-z0-9_.()+-]$",
      "maxLength": 128
    },
    "placeName": {
      "description": "Name of a home, storage zone or train station.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S"
    },
    "face": {
      "enum": [
        "up",
        "down",
        "north",
        "south",
        "east",
        "west"
      ]
    },
    "where": {
      "description": "Default: inventory.",
      "enum": [
        "inventory",
        "storage"
      ]
    },
    "stationKind": {
      "enum": [
        "crafting_table",
        "furnace",
        "blast_furnace",
        "smoker"
      ]
    },
    "vehicleKind": {
      "enum": [
        "boat",
        "minecart",
        "train_seat",
        "nearest"
      ]
    },
    "anyValue": {
      "description": "A number, a string, true/false or an expression object.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/exprObject"
        }
      ]
    },
    "numberValue": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/exprObject"
        }
      ]
    },
    "booleanValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/exprObject"
        }
      ]
    },
    "stringValue": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "$ref": "#/$defs/exprObject"
        }
      ]
    },
    "idValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "$ref": "#/$defs/exprObject"
        }
      ]
    },
    "coordinate": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -30000000,
          "maximum": 30000000
        },
        {
          "$ref": "#/$defs/exprObject"
        }
      ]
    },
    "count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        {
          "$ref": "#/$defs/exprObject"
        }
      ]
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/idValue"
      }
    },
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "target_coords": {
      "type": "object",
      "description": "A block position; dimension defaults to the current one.",
      "properties": {
        "type": {
          "const": "coords"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "dimension": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "target_home": {
      "type": "object",
      "description": "A home set in Alto; without a name the default home.",
      "properties": {
        "type": {
          "const": "home"
        },
        "name": {
          "$ref": "#/$defs/placeName"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "target_storage_zone": {
      "type": "object",
      "description": "A named storage zone of Alto's storage index.",
      "properties": {
        "type": {
          "const": "storage_zone"
        },
        "name": {
          "$ref": "#/$defs/placeName"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "additionalProperties": false
    },
    "target_portal": {
      "type": "object",
      "description": "The nearest known portal (walk next to it).",
      "properties": {
        "type": {
          "const": "portal"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {
          "$ref": "#/$defs/target_coords"
        },
        {
          "$ref": "#/$defs/target_home"
        },
        {
          "$ref": "#/$defs/target_storage_zone"
        },
        {
          "$ref": "#/$defs/target_portal"
        }
      ]
    },
    "block_goto": {
      "type": "object",
      "description": "Walk to a target.",
      "properties": {
        "block": {
          "const": "goto"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "required": [
        "block",
        "target"
      ],
      "additionalProperties": false
    },
    "block_mine": {
      "type": "object",
      "description": "Mine until count more of the block (or of blocks that drop the item) are collected.",
      "properties": {
        "block": {
          "const": "mine"
        },
        "block_or_item": {
          "$ref": "#/$defs/idValue"
        },
        "count": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "block",
        "block_or_item",
        "count"
      ],
      "additionalProperties": false
    },
    "block_build": {
      "type": "object",
      "description": "Build a schematic from Alto's schematics folder with its origin at x, y, z.",
      "properties": {
        "block": {
          "const": "build"
        },
        "schematic": {
          "anyOf": [
            {
              "$ref": "#/$defs/fileName"
            },
            {
              "$ref": "#/$defs/exprObject"
            }
          ]
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "required": [
        "block",
        "schematic",
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "block_fill": {
      "type": "object",
      "description": "Fill the box between two corners (inclusive) with a block ('block' is the block type key, so the block to place is 'material').",
      "properties": {
        "block": {
          "const": "fill"
        },
        "material": {
          "$ref": "#/$defs/idValue"
        },
        "x1": {
          "$ref": "#/$defs/coordinate"
        },
        "y1": {
          "$ref": "#/$defs/coordinate"
        },
        "z1": {
          "$ref": "#/$defs/coordinate"
        },
        "x2": {
          "$ref": "#/$defs/coordinate"
        },
        "y2": {
          "$ref": "#/$defs/coordinate"
        },
        "z2": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "required": [
        "block",
        "material",
        "x1",
        "y1",
        "z1",
        "x2",
        "y2",
        "z2"
      ],
      "additionalProperties": false
    },
    "block_farm": {
      "type": "object",
      "description": "One harvest-and-replant pass over nearby crops.",
      "properties": {
        "block": {
          "const": "farm"
        },
        "range": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "$ref": "#/$defs/exprObject"
            }
          ]
        },
        "crops": {
          "$ref": "#/$defs/idList"
        }
      },
      "required": [
        "block"
      ],
      "additionalProperties": false
    },
    "block_craft": {
      "type": "object",
      "description": "Craft count more of an item.",
      "properties": {
        "block": {
          "const": "craft"
        },
        "item": {
          "$ref": "#/$defs/idValue"
        },
        "count": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "block",
        "item",
        "count"
      ],
      "additionalProperties": false
    },
    "block_smelt": {
      "type": "object",
      "description": "Smelt until count more of the result item (e.g. iron_ingot) are made.",
      "properties": {
        "block": {
          "const": "smelt"
        },
        "item": {
          "$ref": "#/$defs/idValue"
        },
        "count": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "block",
        "item",
        "count"
      ],
      "additionalProperties": false
    },
    "block_fetch": {
      "type": "object",
      "description": "Take count of an item out of known storage.",
      "properties": {
        "block": {
          "const": "fetch"
        },
        "item": {
          "$ref": "#/$defs/idValue"
        },
        "count": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "block",
        "item",
        "count"
      ],
      "additionalProperties": false
    },
    "block_deposit": {
      "type": "object",
      "description": "Put inventory items into storage; except = keep these, only = deposit only these.",
      "properties": {
        "block": {
          "const": "deposit"
        },
        "except": {
          "$ref": "#/$defs/idList"
        },
        "only": {
          "$ref": "#/$defs/idList"
        }
      },
      "required": [
        "block"
      ],
      "additionalProperties": false
    },
    "block_eat": {
      "type": "object",
      "description": "Eat food from the inventory until no longer hungry.",
      "properties": {
        "block": {
          "const": "eat"
        }
      },
      "required": [
        "block"
      ],
      "additionalProperties": false
    },
    "block_wait": {
      "type": "object",
      "description": "Wait some seconds (0 = until the next tick).",
      "properties": {
        "block": {
          "const": "wait"
        },
        "seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            {
              "$ref": "#/$defs/exprObject"
            }
          ]
        }
      },
      "required": [
        "block",
        "seconds"
      ],
      "additionalProperties": false
    },
    "block_message": {
      "type": "object",
      "description": "Show a message to you only (never sent to the server).",
      "properties": {
        "block": {
          "const": "message"
        },
        "text": {
          "$ref": "#/$defs/anyValue"
        }
      },
      "required": [
        "block",
        "text"
      ],
      "additionalProperties": false
    },
    "block_command": {
      "type": "object",
      "description": "Run a Baritone command (literal text, without '/'); only runs when it is on the allowed commands list.",
      "properties": {
        "block": {
          "const": "command"
        },
        "command": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[\\s#]*[^\\s#/]"
        }
      },
      "required": [
        "block",
        "command"
      ],
      "additionalProperties": false
    },
    "block_send_chat": {
      "type": "object",
      "description": "Send a real chat message as you; refused unless scripts may chat (setting).",
      "properties": {
        "block": {
          "const": "send_chat"
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "$ref": "#/$defs/exprObject"
            }
          ]
        }
      },
      "required": [
        "block",
        "text"
      ],
      "additionalProperties": false
    },
    "block_use_item_on_block": {
      "type": "object",
      "description": "Right-click a block face while holding an item.",
      "properties": {
        "block": {
          "const": "use_item_on_block"
        },
        "item": {
          "$ref": "#/$defs/idValue"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "face": {
          "$ref": "#/$defs/face"
        }
      },
      "required": [
        "block",
        "item",
        "x",
        "y",
        "z",
        "face"
      ],
      "additionalProperties": false
    },
    "block_set_filter": {
      "type": "object",
      "description": "Set the filter of a block (e.g. a Create deployer) to an item; face optional.",
      "properties": {
        "block": {
          "const": "set_filter"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "face": {
          "$ref": "#/$defs/face"
        },
        "item": {
          "$ref": "#/$defs/idValue"
        }
      },
      "required": [
        "block",
        "x",
        "y",
        "z",
        "item"
      ],
      "additionalProperties": false
    },
    "block_place_station": {
      "type": "object",
      "description": "Place a work station from the inventory.",
      "properties": {
        "block": {
          "const": "place_station"
        },
        "kind": {
          "$ref": "#/$defs/stationKind"
        }
      },
      "required": [
        "block",
        "kind"
      ],
      "additionalProperties": false
    },
    "block_pickup_station": {
      "type": "object",
      "description": "Pick up a work station Alto placed.",
      "properties": {
        "block": {
          "const": "pickup_station"
        },
        "kind": {
          "$ref": "#/$defs/stationKind"
        }
      },
      "required": [
        "block",
        "kind"
      ],
      "additionalProperties": false
    },
    "block_board_vehicle": {
      "type": "object",
      "description": "Board a vehicle.",
      "properties": {
        "block": {
          "const": "board_vehicle"
        },
        "kind": {
          "$ref": "#/$defs/vehicleKind"
        }
      },
      "required": [
        "block",
        "kind"
      ],
      "additionalProperties": false
    },
    "block_ride_train": {
      "type": "object",
      "description": "Ride a Create train between two named stations.",
      "properties": {
        "block": {
          "const": "ride_train"
        },
        "from_station": {
          "anyOf": [
            {
              "$ref": "#/$defs/placeName"
            },
            {
              "$ref": "#/$defs/exprObject"
            }
          ]
        },
        "to_station": {
          "anyOf": [
            {
              "$ref": "#/$defs/placeName"
            },
            {
              "$ref": "#/$defs/exprObject"
            }
          ]
        }
      },
      "required": [
        "block",
        "from_station",
        "to_station"
      ],
      "additionalProperties": false
    },
    "block_leave_vehicle": {
      "type": "object",
      "description": "Get out of the current vehicle.",
      "properties": {
        "block": {
          "const": "leave_vehicle"
        }
      },
      "required": [
        "block"
      ],
      "additionalProperties": false
    },
    "block_take_portal": {
      "type": "object",
      "description": "Go through a portal and wait for the new dimension.",
      "properties": {
        "block": {
          "const": "take_portal"
        }
      },
      "required": [
        "block"
      ],
      "additionalProperties": false
    },
    "block_stop": {
      "type": "object",
      "description": "End the script.",
      "properties": {
        "block": {
          "const": "stop"
        }
      },
      "required": [
        "block"
      ],
      "additionalProperties": false
    },
    "block_repeat": {
      "type": "object",
      "description": "Run the body a number of times (0 skips it).",
      "properties": {
        "block": {
          "const": "repeat"
        },
        "times": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "$ref": "#/$defs/exprObject"
            }
          ]
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "block",
        "times",
        "body"
      ],
      "additionalProperties": false
    },
    "block_repeat_until": {
      "type": "object",
      "description": "Repeat the body until the condition is true (checked before every pass).",
      "properties": {
        "block": {
          "const": "repeat_until"
        },
        "condition": {
          "$ref": "#/$defs/booleanValue"
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "block",
        "condition",
        "body"
      ],
      "additionalProperties": false
    },
    "block_forever": {
      "type": "object",
      "description": "Repeat the body until break or stop; needs safety stops enabled.",
      "properties": {
        "block": {
          "const": "forever"
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "block",
        "body"
      ],
      "additionalProperties": false
    },
    "block_if": {
      "type": "object",
      "description": "Run 'then' when the condition is true, else 'else'.",
      "properties": {
        "block": {
          "const": "if"
        },
        "condition": {
          "$ref": "#/$defs/booleanValue"
        },
        "then": {
          "$ref": "#/$defs/body"
        },
        "else": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "block",
        "condition",
        "then"
      ],
      "additionalProperties": false
    },
    "block_wait_until": {
      "type": "object",
      "description": "Wait until the condition is true; the run fails after timeout_seconds.",
      "properties": {
        "block": {
          "const": "wait_until"
        },
        "condition": {
          "$ref": "#/$defs/booleanValue"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            {
              "$ref": "#/$defs/exprObject"
            }
          ]
        }
      },
      "required": [
        "block",
        "condition"
      ],
      "additionalProperties": false
    },
    "block_break": {
      "type": "object",
      "description": "Leave the innermost loop.",
      "properties": {
        "block": {
          "const": "break"
        }
      },
      "required": [
        "block"
      ],
      "additionalProperties": false
    },
    "block_call": {
      "type": "object",
      "description": "Call a procedure; args maps every parameter name to a value.",
      "properties": {
        "block": {
          "const": "call"
        },
        "procedure": {
          "$ref": "#/$defs/name"
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/anyValue"
          }
        }
      },
      "required": [
        "block",
        "procedure"
      ],
      "additionalProperties": false
    },
    "block_set_var": {
      "type": "object",
      "description": "Set a variable (same type as its initial value).",
      "properties": {
        "block": {
          "const": "set_var"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "value": {
          "$ref": "#/$defs/anyValue"
        }
      },
      "required": [
        "block",
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "block_change_var": {
      "type": "object",
      "description": "Add delta to a number variable.",
      "properties": {
        "block": {
          "const": "change_var"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "delta": {
          "$ref": "#/$defs/numberValue"
        }
      },
      "required": [
        "block",
        "name",
        "delta"
      ],
      "additionalProperties": false
    },
    "statement": {
      "description": "A block: {\"block\": \"<type>\", ...fields}.",
      "oneOf": [
        {
          "$ref": "#/$defs/block_goto"
        },
        {
          "$ref": "#/$defs/block_mine"
        },
        {
          "$ref": "#/$defs/block_build"
        },
        {
          "$ref": "#/$defs/block_fill"
        },
        {
          "$ref": "#/$defs/block_farm"
        },
        {
          "$ref": "#/$defs/block_craft"
        },
        {
          "$ref": "#/$defs/block_smelt"
        },
        {
          "$ref": "#/$defs/block_fetch"
        },
        {
