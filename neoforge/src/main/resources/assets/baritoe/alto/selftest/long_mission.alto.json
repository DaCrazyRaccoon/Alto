    {
      "name": "log_step",
      "params": [
        {
          "name": "label",
          "type": "string"
        }
      ],
      "body": [
        {
          "block": "change_var",
          "name": "step",
          "delta": 1
        },
        {
          "block": "message",
          "text": {
            "expr": "join",
            "parts": [
              "[",
              {
                "expr": "var",
                "name": "step"
              },
              "] ",
              {
                "expr": "param",
                "name": "label"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "check",
      "params": [
        {
          "name": "ok",
          "type": "boolean"
        },
        {
          "name": "label",
          "type": "string"
        }
      ],
      "body": [
        {
          "block": "if",
          "condition": {
            "expr": "param",
            "name": "ok"
          },
          "then": [
            {
              "block": "change_var",
              "name": "checks_passed",
              "delta": 1
            },
            {
              "block": "message",
              "text": {
                "expr": "join",
                "parts": [
                  "check ok: ",
                  {
                    "expr": "param",
                    "name": "label"
                  }
                ]
              }
            }
          ],
          "else": [
            {
              "block": "message",
              "text": {
                "expr": "join",
                "parts": [
                  "CHECK FAILED: ",
                  {
                    "expr": "param",
                    "name": "label"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
